{
  "name": "CalTrack",
  "short_name": "CalTrack",
  "description": "Calorie + macro tracker with barcode scanning",
  "start_url": "/index.html",
  "display": "standalone",
  "background_color": "#0f1115",
  "theme_color": "#0f1115",
  "lang": "en-US",
  "scope": "/",
  "orientation": "portrait",
  "id": "caltrack",
  "version": "1.2",
  "icons": [
    { "src": "/icons/icon_56.png", "type": "image/png", "sizes": "56x56" },
    { "src": "/icons/icon_112.png", "type": "image/png", "sizes": "112x112" }
  ],
  "b2g_features": {
    "version": "1.2",
    "origin": "caltrack",
    "permissions": {
      "camera": {},
      "systemXHR": {},
      "device-storage:sdcard": { "access": "readwrite" }
    }
  }
}
